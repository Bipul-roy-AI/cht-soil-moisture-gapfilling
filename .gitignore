# Research data/credentials stay on the local computer.
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
.env.*
!.env.example
*.key
*.pem
credentials*.json
service-account*.json

# Keep published figures, summaries and reproducibility manifests tracked,
# but not raw or processed satellite files or models.
data/boundaries/
data/raw/
data/interim/
data/processed/
data/external/
outputs/models/
outputs/tmp/
logs/

# Original user-supplied shapefile components should never be published
# without confirming license/provenance.
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg

# Local operating-system / editor files.
Thumbs.db
.DS_Store
.idea/
.vscode/
